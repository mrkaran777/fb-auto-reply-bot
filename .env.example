# ==========================================
# Facebook & Meta Graph API Configuration
# ==========================================
# Long-lived Page Access Token from Meta Developer Portal
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Your Facebook Page ID (to avoid replying to our own comments in an infinite loop)
PAGE_ID=your_page_id_here

# Custom verification string you enter in Meta Webhooks dashboard
VERIFY_TOKEN=my_secure_fb_webhook_verify_token_2024

# App Secret from Meta App Dashboard (Settings > Basic) for payload signature verification
APP_SECRET=your_facebook_app_secret_here

# Graph API Version
GRAPH_API_VERSION=v20.0

# ==========================================
# Gemini AI Configuration
# ==========================================
# Google AI Studio API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (e.g., gemini-1.5-flash, gemini-1.5-pro, or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# System Prompt / Instructions for AI persona
AI_SYSTEM_PROMPT=You are a friendly, helpful, and professional social media assistant replying to comments on our Facebook Page. Keep replies concise (1-3 sentences), warm, and engaging. Reply in the same language as the user comment (English, Hindi, or Hinglish). Use relevant emojis when appropriate.

# ==========================================
# Automation Features
# ==========================================
# Automatically like user comment before replying
AUTO_LIKE_COMMENTS=true

# Enable/Disable AI replies (true to use Gemini, false to use default fallback message)
ENABLE_AI_REPLIES=true

# Fallback reply if AI fails or is disabled
FALLBACK_REPLY=Thank you for reaching out! We appreciate your comment. 😊

# Server Port & Host
HOST=0.0.0.0
PORT=8000

